{
  "components": {
    "securitySchemes": {
      "oauth2": {
        "description": "OAuth2 with Authorization Code (+ PKCE for public clients) or Client Credentials.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/api/oauth/authorize",
            "refreshUrl": "/api/oauth/token",
            "scopes": {
              "api": "Act on the user's behalf via the API."
            },
            "tokenUrl": "/api/oauth/token"
          },
          "clientCredentials": {
            "scopes": {
              "api": "Server-to-server access on behalf of the client."
            },
            "tokenUrl": "/api/oauth/token"
          }
        },
        "type": "oauth2"
      },
      "pat": {
        "bearerFormat": "mapat_...",
        "description": "Personal Access Token. Issue at /profile/access-tokens, then send as `Authorization: Bearer mapat_...`. Carries the issuing user's identity.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Programmatic access to public events, member-scoped actions (RSVP, comment, image upload), and admin-scoped reads. OAuth2 authentication required for non-public endpoints.",
    "title": "meetAgain API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        },
        "summary": "Health check endpoint",
        "tags": [
          "status"
        ]
      }
    },
    "/api/v1/admin/logs/cron": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated cron log list"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient role"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "List recent cron run log entries",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/logs/cron/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cron log detail"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Cron log not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Get a single cron log entry",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/logs/sendlog": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated sendlog list"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient role"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "List email send-log entries",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/logs/sendlog/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sendlog detail"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Sendlog entry not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Get a single send-log entry",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/security/incidents": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "ISO-8601 datetime lower bound on endedAt",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Incident list"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient role"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "List recent security incidents",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/security/incidents/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Incident detail"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Incident not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Get a single security incident with full provider reports",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/events": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "example": "en",
              "type": "string"
            }
          },
          {
            "description": "ISO-8601 lower bound (default: now)",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "ISO-8601 upper bound",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated event list"
          }
        },
        "summary": "List public upcoming events",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/events/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event detail"
          },
          "404": {
            "description": "Event not found or not visible in current context"
          }
        },
        "summary": "Get a single event by ID",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/events/{id}/comments": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "content": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Comment created"
          },
          "400": {
            "description": "Empty content"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          },
          "403": {
            "description": "Not allowed"
          },
          "404": {
            "description": "Event not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Post a comment on an event",
        "tags": [
          "event-actions"
        ]
      }
    },
    "/api/v1/events/{id}/comments/{commentId}": {
      "delete": {
        "responses": {
          "204": {
            "description": "Comment deleted"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          },
          "403": {
            "description": "Not your comment and not admin"
          },
          "404": {
            "description": "Comment or event not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Delete an event comment (own or admin)",
        "tags": [
          "event-actions"
        ]
      }
    },
    "/api/v1/events/{id}/images": {
      "post": {
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Image uploaded"
          },
          "400": {
            "description": "No file or unsupported format"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          },
          "403": {
            "description": "Not allowed"
          },
          "404": {
            "description": "Event not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Upload an image to an event",
        "tags": [
          "event-actions"
        ]
      }
    },
    "/api/v1/events/{id}/images/{imageId}": {
      "delete": {
        "responses": {
          "204": {
            "description": "Image deleted"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          },
          "403": {
            "description": "Not your image and not admin"
          },
          "404": {
            "description": "Image or event not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Delete an event image (own upload or admin)",
        "tags": [
          "event-actions"
        ]
      }
    },
    "/api/v1/events/{id}/rsvp": {
      "delete": {
        "responses": {
          "200": {
            "description": "RSVP removed (or already absent)"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          },
          "403": {
            "description": "Not allowed"
          },
          "404": {
            "description": "Event not found"
          },
          "409": {
            "description": "Event canceled or already started"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Remove RSVP from an event",
        "tags": [
          "event-actions"
        ]
      },
      "post": {
        "responses": {
          "200": {
            "description": "RSVP added (or already present)"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          },
          "403": {
            "description": "Not allowed (group membership / blocked)"
          },
          "404": {
            "description": "Event not found"
          },
          "409": {
            "description": "Event canceled or already started"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "RSVP yes to an event",
        "tags": [
          "event-actions"
        ]
      }
    },
    "/api/v1/groups": {
      "get": {
        "responses": {
          "200": {
            "description": "Array of group summaries"
          }
        },
        "summary": "List active groups",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/v1/groups/{groupSlug}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "groupSlug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Group detail"
          },
          "404": {
            "description": "Group not found"
          }
        },
        "summary": "Get a group by slug",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/v1/groups/{groupSlug}/admin/members": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "groupSlug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Members list"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Caller is not Owner/Organizer of this group"
          },
          "404": {
            "description": "Group not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "List members of a group",
        "tags": [
          "group-admin"
        ]
      }
    },
    "/api/v1/groups/{groupSlug}/admin/settings": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "groupSlug",
            "required": true,
            "schema": {
              "example": "weiqi-club",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Group settings"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Caller is not Owner/Organizer of this group"
          },
          "404": {
            "description": "Group not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Read a group settings",
        "tags": [
          "group-admin"
        ]
      }
    },
    "/api/v1/groups/{groupSlug}/cms": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "groupSlug",
            "required": true,
            "schema": {
              "example": "weiqi-club",
              "type": "string"
            }
          },
          {
            "description": "Two-letter language code. If omitted, each item's first available language is used. If given but the page lacks that language, falls back to 'en' (or the first available).",
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "example": "en",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of CMS pages"
          },
          "404": {
            "description": "Group not found"
          }
        },
        "summary": "List a group's CMS pages",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/v1/groups/{groupSlug}/cms/{cmsSlug}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "groupSlug",
            "required": true,
            "schema": {
              "example": "platform",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "cmsSlug",
            "required": true,
            "schema": {
              "example": "about",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CMS page metadata"
          },
          "404": {
            "description": "Group not found, or page not found / not visible in this group"
          }
        },
        "summary": "Get a CMS page metadata by group and slug",
        "tags": [
          "groups"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "responses": {
          "200": {
            "description": "User profile"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "Get the authenticated user profile",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/rsvps": {
      "get": {
        "responses": {
          "200": {
            "description": "Array of upcoming events the user has RSVPed to"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          }
        },
        "security": [
          {
            "oauth2": [
              "api"
            ]
          },
          {
            "pat": []
          }
        ],
        "summary": "List the authenticated user upcoming RSVPs",
        "tags": [
          "me"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Current host",
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "Platform-admin actions over the API. Reserved for users with ROLE_ADMIN.",
      "name": "admin"
    },
    {
      "description": "Authenticated user actions on events: RSVP, comments, image upload",
      "name": "event-actions"
    },
    {
      "description": "Public event listings and detail",
      "name": "events"
    },
    {
      "description": "Group-scoped admin actions. Requires Owner or Organizer role in the named group, or platform ROLE_ADMIN.",
      "name": "group-admin"
    },
    {
      "description": "Tenant groups (multisite)",
      "name": "groups"
    },
    {
      "description": "Authenticated user (token-scoped reads)",
      "name": "me"
    },
    {
      "description": "status",
      "name": "status"
    }
  ]
}
