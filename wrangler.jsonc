/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meetagrambot",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-03",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BOT_INFO": "{\"id\":8733038024,\"is_bot\":true,\"first_name\":\"meetagrambot\",\"username\":\"MeetAgramBot\",\"can_join_groups\":true,\"can_read_all_group_messages\":false,\"supports_inline_queries\":false,\"can_connect_to_business\":false}",
		"API_BASE_URL": "https://meetagain.org"
	}
}
